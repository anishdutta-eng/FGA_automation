# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*

# Build output
dist/
build/
dist-ssr/
*.local

# Environment / secrets
.env
.env.*
!.env.example
*.pem
serviceAccount*.json
firebase-debug.log
.firebase/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/

# Misc
*.tsbuildinfo

# TS composite build artifacts (emitted from vite.config.ts)
vite.config.js
vite.config.d.ts

# Generated reports (keep the folder + its README, ignore exports)
reports/*
!reports/README.md

# Personal / local-only documents (not for the repo)
WORK_ACCOMPLISHMENT.md

# ── PCB debug engine (engine/) ────────────────────────────────────────────
# Large binary inputs are kept locally but NOT pushed (they bloat the Pages
# repo and are only needed to regenerate board.json, not at runtime).
engine/source/*.brd
engine/source/**/*.STEP
engine/source/**/*.step
engine/source/**/*.kicad_pcb
engine/source/**/*.kicad_pcb.orig
engine/source/**/*.orig

# The generic build/ rule above also hides engine/build/ — keep the scripts.
!engine/build/
!engine/build/**
